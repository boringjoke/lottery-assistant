# Production profile
SPRING_PROFILES_ACTIVE=prod
LOTTERY_TIME_ZONE=Asia/Shanghai

# Runtime images
# Fill these with the image tags pushed to Alibaba Cloud ACR.
LOTTERY_FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/lottery-frontend:CHANGE_ME_TAG
LOTTERY_BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/lottery-backend:CHANGE_ME_TAG
LOTTERY_CRAWLER_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/lottery-crawler:CHANGE_ME_TAG

# Runtime env file path used by docker-compose.yml.
# If docker-compose.yml and .env.production are in the same directory, keep .env.production.
# If the server layout is /opt/lottery-assistant/compose and /opt/lottery-assistant/env,
# set this to ../env/.env.production in the server env file.
LOTTERY_RUNTIME_ENV_FILE=.env.production

# Docker network
# Must match the external Docker network that already contains MySQL and Redis.
LOTTERY_SHARED_DOCKER_NETWORK=shared-backend
PUBLIC_GATEWAY_DOCKER_NETWORK=public-gateway

# MySQL
# Replace mysql with the existing MySQL container name or network alias.
LOTTERY_DB_URL=jdbc:mysql://mysql:3306/lottery_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
LOTTERY_DB_USERNAME=lottery_app
LOTTERY_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Redis
# Replace redis with the existing Redis container name or network alias.
LOTTERY_REDIS_HOST=redis
LOTTERY_REDIS_PORT=6379
LOTTERY_REDIS_PASSWORD=
LOTTERY_REDIS_DATABASE=1
LOTTERY_REDIS_TIMEOUT=3s
LOTTERY_REDIS_CONNECT_TIMEOUT=3s

# Crawler
LOTTERY_CRAWLER_BASE_URL=http://lottery-crawler:8000
LOTTERY_CRAWLER_CONNECT_TIMEOUT_MILLIS=3000
LOTTERY_CRAWLER_READ_TIMEOUT_MILLIS=10000

# Flyway
LOTTERY_FLYWAY_ENABLED=true

# Sync worker
# Keep backend single-instance before adding distributed locks.
LOTTERY_SYNC_CORE_POOL_SIZE=1
LOTTERY_SYNC_MAX_POOL_SIZE=1
LOTTERY_SYNC_QUEUE_CAPACITY=10
LOTTERY_SYNC_DEFAULT_PAGE_DELAY_MILLIS=2000
LOTTERY_SYNC_TASK_DELAY_MILLIS=10000
LOTTERY_SYNC_MAX_PAGES_PER_TASK=20

# Auto sync latest draw
LOTTERY_SYNC_AUTO_LATEST_ENABLED=false
LOTTERY_SYNC_AUTO_LATEST_CRON=0 30 21 * * *
LOTTERY_SYNC_AUTO_LATEST_ZONE=Asia/Shanghai

# Complete delayed latest draw fields
# Default: 08:00 on Tuesday, Thursday and Sunday.
LOTTERY_SYNC_LATEST_COMPLETION_ENABLED=false
LOTTERY_SYNC_LATEST_COMPLETION_CRON=0 0 8 ? * TUE,THU,SUN
LOTTERY_SYNC_LATEST_COMPLETION_ZONE=Asia/Shanghai

# Auth and favorites
LOTTERY_AUTH_SESSION_TTL_SECONDS=604800
LOTTERY_FAVORITE_MAX_ACTIVE_COUNT=100

# Mail
# Keep disabled until SMTP credentials are confirmed.
LOTTERY_MAIL_ENABLED=false
LOTTERY_MAIL_HOST=
LOTTERY_MAIL_PORT=465
LOTTERY_MAIL_USERNAME=
LOTTERY_MAIL_PASSWORD=
LOTTERY_MAIL_FROM=
LOTTERY_MAIL_AUTH=true
LOTTERY_MAIL_SSL_ENABLED=true
LOTTERY_MAIL_STARTTLS_ENABLED=false
LOTTERY_MAIL_CONNECT_TIMEOUT_MILLIS=5000
LOTTERY_MAIL_READ_TIMEOUT_MILLIS=10000
